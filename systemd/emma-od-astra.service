[Unit]
Description=EMMA Astra object detection for dashboard
Requires=emma-video.service emma-astra-depth.service
After=emma-video.service emma-astra-depth.service
PartOf=emma-vision.target
ConditionPathExists=/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._USB_2.0_Camera_SN0001-video-index0

[Service]
Type=simple
ExecStart=/home/jetson/emma/src/emma_dashboard/scripts/run-od-astra.sh
Restart=on-failure
RestartPreventExitStatus=16
RestartSec=3

[Install]
WantedBy=default.target
