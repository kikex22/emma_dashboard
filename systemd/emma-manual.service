[Unit]
Description=EMMA Manual Base and Arm
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/jetson/emma
ExecStart=/home/jetson/emma/src/emma_dashboard/scripts/run-manual.sh
Restart=no
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=25
StandardInput=null

[Install]
WantedBy=default.target
