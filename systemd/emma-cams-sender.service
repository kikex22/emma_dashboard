[Unit]
Description=EMMA arm raw camera sender for dashboard
Requires=emma-video.service
After=emma-video.service
PartOf=emma-vision.target

[Service]
Type=simple
ExecStart=/home/jetson/emma/src/emma_dashboard/scripts/run-cams-sender.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
