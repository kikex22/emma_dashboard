#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="/var/lib/emma-clock"
STATE_FILE="$STATE_DIR/last_epoch"
MIN_VALID_EPOCH=1600000000

save_clock() {
  local now tmp
  now="$(date +%s)"
  if (( now <= MIN_VALID_EPOCH )); then
    echo "Reloj invalido; no se sobrescribe la ultima hora guardada." >&2
    return 1
  fi

  install -d -m 0755 "$STATE_DIR"
  tmp="$(mktemp "$STATE_DIR/.last_epoch.XXXXXX")"
  printf '%s\n' "$now" > "$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$STATE_FILE"
}

restore_clock() {
  local current saved

  # rtc0 is registered late on Jetson and resets the clock to 1970.
  for _attempt in $(seq 1 100); do
    [[ -e /dev/rtc0 ]] && break
    sleep 0.1
  done
  sleep 1

  [[ -r "$STATE_FILE" ]] || return 0
  saved="$(tr -cd '0-9' < "$STATE_FILE")"
  [[ -n "$saved" ]] || return 0
  current="$(date +%s)"

  if (( saved > MIN_VALID_EPOCH && current < saved )); then
    date --set="@$saved"
  fi
  save_clock
}

case "${1:-}" in
  save)
    save_clock
    ;;
  restore)
    restore_clock
    ;;
  *)
    echo "Uso: $0 {save|restore}" >&2
    exit 2
    ;;
esac
